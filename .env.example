# ---------------------------------------------------------------------------
# QuizMaster configuration — copy to `.env` and fill in real values.
# NEVER commit your real .env file. Placeholders only below.
# ---------------------------------------------------------------------------

# development | production
APP_ENV=development
FLASK_DEBUG=1
APP_TIMEZONE=Asia/Kolkata
# Public URL used in email links (no trailing slash)
APP_BASE_URL=http://127.0.0.1:5000

# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
# (Development auto-generates one in instance/.secret_key if left empty;
#  production REFUSES to start without it.)
SECRET_KEY=
TOKEN_PEPPER=

# Database (default: SQLite file in instance/). PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/quizmaster
DATABASE_URL=

# --- Email / SMTP (required for real OTP + password-reset delivery) ---------
# Gmail: enable 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords and use it as MAIL_PASSWORD.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your.address@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER=QuizMaster <your.address@gmail.com>
# Where "Contact us" messages are also forwarded (optional)
SUPPORT_EMAIL=
# Development-only: when SMTP is NOT configured, save emails to instance/outbox
# and preview them at /dev/outbox. Ignored in production.
MAIL_DEV_OUTBOX=true

# --- First administrator (optional bootstrap; used once if no admin exists) --
# Prefer:  flask --app app create-admin
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=QuizMaster Admin

# --- Security tuning ---------------------------------------------------------
SESSION_LIFETIME_MINUTES=120
# Set true when served over HTTPS (forced true in production)
SESSION_COOKIE_SECURE=false
# Lax (default). Use None only when embedding over HTTPS in a cross-site iframe.
SESSION_COOKIE_SAMESITE=Lax
# Only for HTTPS cross-site iframe embedding (with SameSite=None + Secure)
SESSION_COOKIE_PARTITIONED=false
# Who may embed the site in an iframe ('self' in production by default)
FRAME_ANCESTORS=
# Set 1 behind a reverse proxy (nginx, Render, Railway...)
TRUST_PROXY=0
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
RESET_TOKEN_TTL_MINUTES=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Rate-limit storage. Use Redis in multi-process production, e.g. redis://localhost:6379
RATELIMIT_STORAGE_URI=memory://

# --- Backups ----------------------------------------------------------------
AUTO_BACKUP_ENABLED=true
BACKUP_KEEP=14
